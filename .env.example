# Airtable personal access tokens. Two scopes, two tokens:
#  - AIRTABLE_TOKEN (data.records:write) is used ONLY by the Vercel registration
#    function, which writes rows.
#  - AIRTABLE_READ_TOKEN (data.records:read) is for builds — local and CI only
#    ever GET sponsors/schedule/registrations. The Pages workflow prefers the
#    read token and falls back to AIRTABLE_TOKEN until the read PAT exists.
AIRTABLE_TOKEN=
AIRTABLE_READ_TOKEN=

# Base ID starts with "app", find it at https://airtable.com/api
AIRTABLE_BASE_ID=

# Table name (or table ID starting with "tbl") for registrations
AIRTABLE_TABLE=Guests

# reCAPTCHA v3 keys from https://www.google.com/recaptcha/admin — the PUBLIC_ one
# ships to the browser, the secret stays server-side. Both optional; the form
# falls back to honeypot-only protection when unset.
PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Where the registration form posts — the Vercel-hosted function URL.
# Leave empty when the site itself runs on Vercel (same-origin /api/register).
PUBLIC_FORM_ENDPOINT=https://be-camp-website.vercel.app/api/register

# "true" fakes the registrant count (78) and attendee directory (26 sample names)
# at build time so the gated UI is reviewable before real registrations exist.
# Unset/false — the production default — reads real Airtable data.
USE_FAKE_DATA=true
