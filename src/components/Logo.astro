---
import logo from '../assets/icons/logo.svg';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<a href="/" class={`flex w-fit shrink-0 items-center gap-2.5 ${className}`} aria-label="beCamp home">
  <img src={logo.src} alt="beCamp Charlottesville" width="180" height="40" class="w-[180px] max-w-none" />
  <span class="h-[35px] w-px bg-white/20 max-[359px]:hidden" aria-hidden="true"></span>
  <span class="text-base font-medium tracking-[-0.07em] whitespace-nowrap text-white max-[359px]:hidden"
    >20<sup class="text-[0.5em] tracking-[-0.04em]">th</sup> anniversary</span
  >
</a>
