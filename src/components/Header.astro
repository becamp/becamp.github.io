---
import Logo from './Logo.astro';
import LogoMark from './LogoMark.astro';
import Button from './Button.astro';
import { getRegistrantCount, REGISTRANT_THRESHOLD } from '../lib/airtable';

/* The Attendees link appears alongside the directory once registrations hit the
   threshold; getRegistrantCount() is memoized, so this costs one fetch per build. */
const showAttendees = (await getRegistrantCount()) >= REGISTRANT_THRESHOLD;

const navLinks = [
  { href: '/schedule', label: 'Schedule' },
  { href: '/sponsors', label: 'Sponsors' },
  ...(showAttendees ? [{ href: '/attendees', label: 'Attendees' }] : []),
  { href: '/about', label: 'About' },
  { href: '/faqs', label: 'FAQs' },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const activeDot =
  "after:absolute after:-bottom-2.5 after:left-1/2 after:size-1.5 after:-translate-x-1/2 after:rotate-45 after:bg-primary after:content-['']";
const isActive = (href: string) => currentPath === href;
---

<header class="relative px-5 py-6 sm:px-20 sm:py-10">
  <div class="flex items-center justify-between">
    <LogoMark class="sm:hidden" />
    <Logo class="max-sm:hidden" />

    <nav class="hidden items-center gap-9 font-mono text-sm text-white lg:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`relative transition-colors duration-150 hover:text-primary ${isActive(link.href) ? activeDot : ''}`}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/register"
        class={`relative text-primary transition-colors duration-150 hover:text-[#ff8b33] ${isActive('/register') ? activeDot : ''}`}
      >
        Register
      </a>
    </nav>

    <div class="flex items-center gap-3 lg:hidden">
      <Button href="/register" class="px-3 py-2 text-sm">Register</Button>
      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle menu"
        class="flex size-10 shrink-0 flex-col items-center justify-center gap-1.5"
      >
        <span class="h-px w-5 bg-white"></span>
        <span class="h-px w-5 bg-white"></span>
        <span class="h-px w-5 bg-white"></span>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="fixed inset-0 z-50 hidden flex-col bg-bg px-5 pb-8 pt-6 sm:px-20 sm:pt-10 lg:hidden"
  >
    <!-- min-h matches the header row (44px, set by the Register button) so the
         logo lands exactly where the header's logo sits when the menu opens. -->
    <div class="flex min-h-11 items-center justify-between">
      <Logo />
      <button
        id="menu-close"
        type="button"
        aria-label="Close menu"
        class="flex size-10 items-center justify-center text-2xl text-white"
      >
        &#10005;
      </button>
    </div>

    <div class="mt-auto flex flex-col">
      <div class="flex flex-col divide-y divide-white/10 border-t border-white/10 font-mono text-2xl text-white">
        {navLinks.map((link) => (
          <a href={link.href} class={`py-5 ${isActive(link.href) ? 'text-primary' : ''}`}>
            {link.label}
          </a>
        ))}
      </div>
      <Button href="/register" class="mt-8 w-full py-4 text-lg">Register</Button>
    </div>
  </nav>
</header>

<script>
  /* Re-runs per navigation (astro:page-load): the router swaps in a fresh header,
     so listeners attach to the new elements each time. */
  const init = () => {
    const toggle = document.getElementById('menu-toggle');
    const closeBtn = document.getElementById('menu-close');
    const menu = document.getElementById('mobile-menu');

    const setOpen = (open: boolean) => {
      menu?.classList.toggle('hidden', !open);
      menu?.classList.toggle('flex', open);
      document.body.classList.toggle('overflow-hidden', open);
      toggle?.setAttribute('aria-expanded', String(open));
    };

    toggle?.addEventListener('click', () => setOpen(Boolean(menu?.classList.contains('hidden'))));
    closeBtn?.addEventListener('click', () => setOpen(false));
  };

  document.addEventListener('astro:page-load', init);
</script>
