---
import Logo from './Logo.astro';
import LogoMark from './LogoMark.astro';
import Button from './Button.astro';

const navLinks = [
  { href: '/schedule', label: 'Schedule' },
  { href: '/sponsors', label: 'Sponsors' },
  { href: '/about', label: 'About' },
  { href: '/faqs', label: 'FAQs' },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const activeDot =
  "after:absolute after:-bottom-2.5 after:left-1/2 after:size-1.5 after:-translate-x-1/2 after:rotate-45 after:bg-primary after:content-['']";
const isActive = (href: string) => currentPath === href;
---

<header class="relative px-5 py-6 sm:px-20 sm:py-10">
  <div class="flex items-center justify-between">
    <LogoMark class="sm:hidden" />
    <Logo class="hidden sm:block" />

    <nav class="hidden items-center gap-9 font-mono text-sm text-white sm:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`relative transition-colors duration-150 hover:text-primary ${isActive(link.href) ? activeDot : ''}`}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/register"
        class={`relative text-primary transition-colors duration-150 hover:text-[#ff8b33] ${isActive('/register') ? activeDot : ''}`}
      >
        Register [R]
      </a>
    </nav>

    <div class="flex items-center gap-3 sm:hidden">
      <Button href="/register" class="px-3 py-2 text-sm">Register [R]</Button>
      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle menu"
        class="flex size-10 shrink-0 flex-col items-center justify-center gap-1.5"
      >
        <span class="h-px w-5 bg-white"></span>
        <span class="h-px w-5 bg-white"></span>
        <span class="h-px w-5 bg-white"></span>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="absolute inset-x-0 top-full z-10 hidden flex-col gap-5 bg-bg px-5 pb-6 font-mono text-sm text-white sm:hidden"
  >
    {navLinks.map((link) => (
      <a href={link.href} class={isActive(link.href) ? 'text-primary' : ''}>
        {link.label}
      </a>
    ))}
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('flex');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });
</script>
