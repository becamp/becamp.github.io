---
import SectionLabel from './SectionLabel.astro';
import Button from './Button.astro';
import PhotoMosaic from './PhotoMosaic.astro';

const VIDEO_EMBED_URL = 'https://www.youtube-nocookie.com/embed/aVMBvWumoF8?autoplay=1';
---

<section class="pt-16">
  <div class="px-5 sm:px-20">
  <div class="max-w-[583px]">
    <SectionLabel>Celebrating our 20th anniversary</SectionLabel>
    <h2 class="mt-3 text-4xl font-medium tracking-[-0.36px] text-white">
      Why should I attend beCamp?
    </h2>
    <p class="mt-4 text-base leading-relaxed text-white/80">
      Join a Charlottesville staple. For 20 years, beCamp has been bringing the local
      tech community together to connect, share, and spend a day learning something
      new. There's nothing else quite like it in town.
    </p>
    <Button href="#video" id="video-open" variant="secondary" class="mt-8">What is beCamp?</Button>
  </div>
  </div>

  <PhotoMosaic />
</section>

<div
  id="video-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-bg/95 p-4 sm:p-10"
>
  <button
    id="video-close"
    type="button"
    aria-label="Close video"
    class="absolute right-5 top-5 flex size-10 items-center justify-center text-2xl text-white transition-colors duration-150 hover:text-primary"
  >
    &#10005;
  </button>
  <div class="aspect-video w-full">
    <iframe
      id="video-iframe"
      class="size-full"
      title="What is beCamp?"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>
</div>

<script>
  const VIDEO_EMBED_URL = 'https://www.youtube-nocookie.com/embed/aVMBvWumoF8?autoplay=1';

  /* Module-level refs, refreshed per navigation: the document-wide Escape
     listener attaches once, while element listeners re-bind to each page's
     fresh modal (null on pages without the video section). */
  let modal: HTMLElement | null = null;
  let iframe: HTMLIFrameElement | null = null;

  const setOpen = (open: boolean) => {
    modal?.classList.toggle('hidden', !open);
    modal?.classList.toggle('flex', open);
    document.body.classList.toggle('overflow-hidden', open);
    if (iframe) iframe.src = open ? VIDEO_EMBED_URL : '';
  };

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) setOpen(false);
  });

  const init = () => {
    modal = document.getElementById('video-modal');
    iframe = document.getElementById('video-iframe') as HTMLIFrameElement | null;
    const openBtn = document.getElementById('video-open');
    const closeBtn = document.getElementById('video-close');

    openBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      setOpen(true);
    });
    closeBtn?.addEventListener('click', () => setOpen(false));
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) setOpen(false);
    });
  };

  document.addEventListener('astro:page-load', init);
</script>
