---
import SectionLabel from './SectionLabel.astro';
import Button from './Button.astro';
import PhotoMosaic from './PhotoMosaic.astro';
---

<section class="pt-16">
  <div class="px-5 sm:px-20">
  <div class="max-w-[583px]">
    <SectionLabel>Why attend?</SectionLabel>
    <h2 class="mt-3 text-4xl font-medium tracking-[-0.36px] text-white">
      Why should I attend beCamp?
    </h2>
    <p class="mt-4 text-base leading-relaxed text-white/80">
      beCamp is your chance to connect with your peers from the Charlottesville tech
      community and spend a day learning something new. There's nothing else quite like it
      in town.
    </p>
    <Button href="https://www.youtube.com/watch?v=aVMBvWumoF8" external variant="secondary" class="mt-8">What is beCamp? [V]</Button>
  </div>
  </div>

  <PhotoMosaic />
</section>
