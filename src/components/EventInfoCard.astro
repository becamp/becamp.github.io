---
import TextLink from './TextLink.astro';

interface Venue {
  name: string;
  directionsHref: string;
  note?: string;
}

interface Props {
  day: string;
  title: string;
  venues: Venue[];
  class?: string;
}

const { day, title, venues, class: className = '' } = Astro.props;
const hasNotes = venues.some((venue) => venue.note);
---

<div class={`relative min-h-[146px] w-full overflow-hidden border border-white/[0.08] bg-white/[0.03] ${className}`}>
  <div class="flex h-full flex-col gap-1.5 px-5 py-5">
    <p class="font-mono text-xs text-white/50">{day}</p>
    <p class="text-xl font-medium tracking-[-0.2px] text-white">{title}</p>
    <div class="mt-2 flex flex-col gap-3">
      {venues.map((venue) => (
        <div class="flex gap-3">
          {hasNotes && (
            <span class="w-9 shrink-0 pt-0.5 font-mono text-xs text-white/50">{venue.note}</span>
          )}
          <div class="flex flex-col gap-0.5">
            <p class="text-sm text-white/80">{venue.name}</p>
            <TextLink href={venue.directionsHref} external class="text-[13px]">Directions →</TextLink>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
