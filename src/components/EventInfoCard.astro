---
import TextLink from './TextLink.astro';

interface Venue {
  name: string;
  directionsHref: string;
  note?: string;
}

interface Props {
  day: string;
  title: string;
  venues: Venue[];
  class?: string;
}

const { day, title, venues, class: className = '' } = Astro.props;
---

<div class={`relative min-h-[146px] w-full overflow-hidden border border-white/[0.08] bg-white/[0.03] ${className}`}>
  <div class="flex h-full flex-col justify-center gap-1.5 px-5 py-4">
    <p class="font-mono text-xs text-white/50">{day}</p>
    <p class="text-xl font-medium tracking-[-0.2px] text-white">{title}</p>
    {venues.map((venue) => (
      <div class="flex flex-wrap items-baseline justify-between gap-x-3">
        <p class="text-sm text-white/80">
          {venue.note && <span class="font-mono text-xs text-white/50">{venue.note} · </span>}
          {venue.name}
        </p>
        <TextLink href={venue.directionsHref} external class="shrink-0 text-[13px]">Directions →</TextLink>
      </div>
    ))}
  </div>
</div>
