---
import Button from './Button.astro';
import EventInfoCard from './EventInfoCard.astro';
import { getRegistrantCount } from '../lib/airtable';

/* Shown only once at least 20 people have registered (ported from the old site). */
const registrantCount = await getRegistrantCount();
---

<!-- The flame shader behind this hero renders once at the Layout level and
     persists across navigations. -->
<section class="relative">
  <div class="pointer-events-none relative px-5 sm:px-20 pt-24 pb-16">
    <div class="pointer-events-auto max-w-[660px]">
    <p class="font-mono text-sm text-primary">October 2–3 in Charlottesville, VA</p>
    <h1 class="mt-3 text-5xl font-medium leading-none tracking-[-0.64px] text-white sm:whitespace-nowrap sm:text-[64px]">
      The un-conference
    </h1>
    <p class="mt-4 text-base text-white/80">The tech conference planned by the people who show up.</p>
    {registrantCount >= 20 && (
      <p class="mt-2 font-mono text-sm text-primary">Join your {registrantCount} peers at beCamp!</p>
    )}

    <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2">
      <EventInfoCard
        day="Fri, Oct 2 from 4:30–8:30pm"
        title="Reception & Pitch night"
        venues={[
          {
            note: '4:30',
            name: 'The Poplar Restaurant',
            directionsHref: 'https://www.google.com/maps/search/?api=1&query=The+Poplar+Restaurant+2017+Ivy+Rd+Charlottesville+VA',
          },
          {
            note: '5:30',
            name: 'UVA School of Data Science',
            directionsHref: 'https://www.google.com/maps/place/School+of+Data+Science/data=!4m2!3m1!1s0x0:0x4105c4fd4e527c99?sa=X&ved=1t:2428&ictx=111',
          },
        ]}
      />
      <EventInfoCard
        day="Sat, Oct 3 from 9am–4pm"
        title="Sessions"
        venues={[
          {
            name: 'UVA School of Data Science',
            directionsHref: 'https://www.google.com/maps/place/School+of+Data+Science/data=!4m2!3m1!1s0x0:0x4105c4fd4e527c99?sa=X&ved=1t:2428&ictx=111',
          },
        ]}
      />
    </div>

    <Button href="/register" class="mt-8 w-full">Register now</Button>
    </div>
  </div>
</section>

