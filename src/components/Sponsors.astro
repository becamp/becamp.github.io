---
import { Image } from 'astro:assets';
import SectionLabel from './SectionLabel.astro';
import TextLink from './TextLink.astro';
import SponsorPlaceholder from './SponsorPlaceholder.astro';
import { getSponsors } from '../lib/airtable';
import { BECOME_SPONSOR_HREF, BECOME_PREMIER_HREF } from '../lib/sponsorship';

const { premier, regular } = await getSponsors();
---

<section class="px-5 sm:px-20 pt-24">
  <SectionLabel>Sponsors</SectionLabel>
  <div class="mt-4 flex max-w-[996px] flex-col gap-4">
    <h2 class="max-w-[578px] text-4xl font-medium tracking-[-0.36px] text-white">
      beCamp wouldn't be possible without our awesome sponsors!
    </h2>
    <p class="max-w-[567px] text-base leading-relaxed text-white/80">
      The following generous sponsors support the local Charlottesville tech
      community and help make beCamp a reality.
    </p>
  </div>

  <div class="mt-8 flex flex-wrap gap-x-10 gap-y-2">
    <TextLink href="/sponsors" class="text-base">Meet all our sponsors →</TextLink>
    <TextLink href="mailto:ozanzal+becamp@gmail.com?subject=beCamp%20Sponsorship" external class="text-base">Want to become a sponsor? →</TextLink>
  </div>

  <h3 class="mt-20 text-xl font-medium tracking-[-0.2px] text-white">Premier Sponsors</h3>
  <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-3">
    {premier.map((sponsor) => (
      <a
        href={`/sponsors#${sponsor.slug}`}
        class="flex aspect-square items-center justify-center border border-white/[0.08] bg-white/[0.03] p-10 transition-colors duration-150 hover:border-primary/60 hover:bg-white/[0.08] lg:p-16"
      >
        {sponsor.logo ? (
          <Image
            src={sponsor.logo.url}
            width={sponsor.logo.width}
            height={sponsor.logo.height}
            alt={sponsor.name}
            class="h-18 w-56 max-w-full object-contain brightness-0 invert"
          />
        ) : (
          <span class="text-center text-xl font-medium text-white">{sponsor.name}</span>
        )}
      </a>
    ))}
    <SponsorPlaceholder href={BECOME_PREMIER_HREF} label="Click to become a Premier Sponsor" class="aspect-square" />
  </div>

  <h3 class="mt-16 text-xl font-medium tracking-[-0.2px] text-white">Sponsors</h3>
  <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-3">
    {regular.map((sponsor) => (
      <a
        href={sponsor.url ?? `/sponsors#${sponsor.slug}`}
        target={sponsor.url ? '_blank' : undefined}
        rel={sponsor.url ? 'noopener' : undefined}
        class="flex h-32 items-center justify-center border border-white/[0.08] bg-white/[0.03] p-6 transition-colors duration-150 hover:border-primary/60 hover:bg-white/[0.08]"
      >
        {sponsor.logo ? (
          <Image
            src={sponsor.logo.url}
            width={sponsor.logo.width}
            height={sponsor.logo.height}
            alt={sponsor.name}
            class="h-14 w-44 max-w-full object-contain brightness-0 invert"
          />
        ) : (
          <span class="text-center text-lg font-medium text-white">{sponsor.name}</span>
        )}
      </a>
    ))}
    <SponsorPlaceholder href={BECOME_SPONSOR_HREF} label="Click to become a sponsor" class="h-32" />
  </div>
</section>
