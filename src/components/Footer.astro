---
import Logo from './Logo.astro';
import { getRegistrantCount, REGISTRANT_THRESHOLD } from '../lib/airtable';

const showAttendees = (await getRegistrantCount()) >= REGISTRANT_THRESHOLD;

const navLinks = [
  { href: '/schedule', label: 'Schedule' },
  { href: '/sponsors', label: 'Sponsors' },
  ...(showAttendees ? [{ href: '/attendees', label: 'Attendees' }] : []),
  { href: '/about', label: 'About' },
  { href: '/faqs', label: 'FAQs' },
];

const secondaryLinks = [
  /* Cville tech community's shared code of conduct. */
  { href: 'https://github.com/cville/conduct', label: 'Code of Conduct', external: true },
  { href: 'mailto:ozanzal+becamp@gmail.com?subject=beCamp%20Sponsorship', label: 'Become a Sponsor' },
  { href: 'mailto:ozanzal+becamp@gmail.com', label: 'Contact organizers' },
];
---

