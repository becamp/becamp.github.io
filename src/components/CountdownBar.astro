<!-- Slim countdown bar above the header on every page. Server-renders a stable
     placeholder (no numbers) to avoid a flash of wrong time; the script swaps in
     the live countdown, flips to "happening now" during the event, and hides the
     bar once the event is over. -->
<a
  id="countdown-bar"
  href="/register"
  class="block bg-primary px-5 py-2 text-center font-mono text-xs font-semibold text-bg transition-colors duration-150 hover:bg-[#ff8b33] sm:text-sm"
>
  <span id="countdown-text">beCamp starts October 2&ndash;3 &rarr;</span>
</a>

<script>
  /* Reception starts Fri Oct 2, 2026 4:30pm ET; sessions end Sat Oct 3, 4pm ET. */
  const EVENT_START = new Date('2026-10-02T16:30:00-04:00').getTime();
  const EVENT_END = new Date('2026-10-03T16:00:00-04:00').getTime();

  const bar = document.getElementById('countdown-bar') as HTMLAnchorElement | null;
  const text = document.getElementById('countdown-text');

  if (bar && text) {
    const pad = (n: number) => String(n).padStart(2, '0');

    /* Re-diffs the wall clock every tick — the old site decremented a stored
       delta instead, which drifted with timer jitter and tab throttling. */
    const render = () => {
      const now = Date.now();
      if (now >= EVENT_END) {
        bar.remove();
        clearInterval(timer);
        return;
      }
      if (now >= EVENT_START) {
        text.textContent = 'beCamp is happening now →';
        bar.href = '/schedule';
        return;
      }
      const diff = EVENT_START - now;
      const d = Math.floor(diff / 86_400_000);
      const h = Math.floor(diff / 3_600_000) % 24;
      const m = Math.floor(diff / 60_000) % 60;
      const s = Math.floor(diff / 1_000) % 60;
      text.textContent = `beCamp starts in ${d}d ${pad(h)}h ${pad(m)}m ${pad(s)}s`;
    };

    const timer = setInterval(render, 1000);
    render();
  }
</script>
