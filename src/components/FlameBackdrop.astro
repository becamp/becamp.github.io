<!-- Rendered once by Layout with identical geometry on every page, and
     transition:persist carries this exact DOM node (GPU context and all)
     across client-side navigations — the blob animation runs continuously
     instead of restarting, so nothing blinks or shifts between pages.
     pointer-events-none is safe: the shader library tracks the cursor on
     window, not the canvas. -->
<!-- Geometry mirrors the homepage hero's original box (below the countdown bar
     and header) so the composition sits exactly where the design placed it,
     on every page. -->
<!-- hidden sm:block: no shader (or fallback) on phones — it sat behind the text
     and hurt readability. -->
<div
  transition:persist="hero-shader"
  class="pointer-events-none absolute inset-x-0 top-[128px] hidden h-[869px] overflow-hidden sm:top-[156px] sm:block sm:h-[645px]"
  aria-hidden="true"
>
  <canvas id="hero-shader" class="absolute inset-0 size-full"></canvas>
  <!-- Static impression of the shader — the flame mark under a soft glow —
       revealed when WebGPU is unavailable (older Safari), the GPU fails
       terminally, or the visitor prefers reduced motion. -->
  <div id="hero-shader-fallback" class="absolute inset-0 hidden">
    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 lg:left-[70%]">
      <div class="absolute inset-0 scale-[1.7] rounded-full bg-[#FF750F] opacity-25 blur-[90px]"></div>
      <img src="/shader-flame.svg" alt="" width="480" height="479" class="relative w-[min(480px,85vw)]" />
    </div>
  </div>
</div>

<script>
  import { createShader } from 'shaders/js';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const BLOB_ID = 'idmrmazjb3edkjkgryq';
  const FLAME_ID = 'idmrmaxo7uuixb4z9yy';

  // Slide the composition left as the viewport narrows from 1440px down to
  // 1024px, drifting the flame behind the frosted hero cards; below that it
  // stays near center. The flame texture also shrinks to fit narrow screens.
  const leftShift = () =>
    0.21 * Math.min(1, Math.max(0, (1440 - window.innerWidth) / (1440 - 1024)));

  const blobCenter = (shift: number) => ({ x: 0.73 - shift, y: 0.5 });
  const flameBoundingBox = (shift: number) => {
    const size = Math.min(480, window.innerWidth * 0.85);
    return {
      x: { unit: 'uv', value: 0.229 - shift },
      width: { unit: 'px', value: size },
      height: { unit: 'px', value: size * (479 / 480) },
      origin: 'center',
    };
  };

  /* The canvas normally persists across navigations, so init only builds a
     shader when it finds a canvas it hasn't seen (first load, hard reload).
     The generation counter discards creations that resolve after the visitor
     has already moved on. */
  let generation = 0;
  let activeCanvas: HTMLCanvasElement | null = null;
  let activeShader: {
    destroy(): void;
    update(id: string, props: Record<string, any>): void;
    resize(width?: number, height?: number): void;
  } | null = null;
  let activeObserver: ResizeObserver | null = null;
  let activeApplyLayout: (() => void) | null = null;
  let settle = 0;
  let widthCheck = 0;

  const teardown = () => {
    activeObserver?.disconnect();
    activeObserver = null;
    activeApplyLayout = null;
    clearTimeout(settle);
    clearInterval(widthCheck);
    activeShader?.destroy();
    activeShader = null;
    activeCanvas = null;
  };

  /* Reasons the library reports exactly once when the shader will never draw —
     the cue to show the static fallback (docs: ShaderOptions.onError). */
  const TERMINAL_REASONS = new Set([
    'unsupported', 'no-adapter', 'no-device', 'init-failed', 'device-lost',
    'out-of-memory', 'gpu-error', 'render-failed', 'limit-exceeded',
    'unrecoverable', 'rebuild_failed',
  ]);

  const showFallback = () => {
    document.getElementById('hero-shader-fallback')?.classList.remove('hidden');
  };

  /* The backdrop is display:none below sm — don't burn a GPU context for a
     canvas nobody sees. Re-inits if the viewport later crosses the breakpoint. */
  const desktopViewport = window.matchMedia('(min-width: 640px)');

  const init = () => {
    if (!desktopViewport.matches) {
      teardown();
      return;
    }
    const canvas = document.getElementById('hero-shader') as HTMLCanvasElement | null;
    if (canvas && canvas === activeCanvas && activeShader) {
      /* Persisted across navigation — keep the running instance, just re-assert
         geometry in case anything shifted during the swap. */
      activeApplyLayout?.();
      return;
    }
    teardown();
    const gen = ++generation;
    if (!canvas) return;
    if (reducedMotion) {
      showFallback();
      return;
    }
    activeCanvas = canvas;
    const shift = leftShift();

    createShader(canvas, {
      components: [
        {
          type: 'Blob',
          id: BLOB_ID,
          props: {
            center: blobCenter(shift),
            deformation: 0.3,
            opacity: 0.6,
            seed: 0,
            size: 0.45,
            softness: 0.9,
            speed: 2,
            stops: [
              { color: '#FF750F', position: 0 },
              { color: '#FF750F', position: 1 },
            ],
          },
        },
        {
          type: 'ImageTexture',
          id: FLAME_ID,
          props: {
            boundingBox: flameBoundingBox(shift),
            url: '/shader-flame.svg',
          },
        },
        {
          type: 'ChromaFlow',
          id: 'idmrmay9k7pjeqbux4s',
          props: {
            baseColor: '#FF750F',
            intensity: 0.9,
            leftColor: '#FF750F',
            maskSource: FLAME_ID,
            radius: 2.2,
            rightColor: '#ffbb00',
            upColor: '#c4450c',
          },
        },
        {
          type: 'CursorRipples',
          id: 'idmrmb51qyx6k82aeql',
          props: {
            intensity: 1,
            maskSource: BLOB_ID,
            visible: true,
          },
        },
      ],
    }, {
      onError: (reason: string) => {
        if (TERMINAL_REASONS.has(reason)) showFallback();
      },
    })
      .then((shader) => {
        if (gen !== generation) {
          /* The visitor already navigated on; this instance is orphaned. */
          shader.destroy();
          return;
        }
        activeShader = shader;

        let appliedFor = 0;
        let appliedCanvasW = 0;
        const applyLayout = () => {
          /* The library sizes the canvas from getBoundingClientRect and writes
             the result as inline styles; if it measured mid-layout (or mid-swap)
             those can be stale. Clear them, measure real layout, and resize
             explicitly. */
          canvas.style.width = '';
          canvas.style.height = '';
          const w = canvas.offsetWidth;
          const h = canvas.offsetHeight;
          if (w && h) shader.resize(w, h);
          appliedCanvasW = canvas.offsetWidth;
          appliedFor = window.innerWidth;
          const s = leftShift();
          shader.update(BLOB_ID, { center: blobCenter(s) });
          shader.update(FLAME_ID, { boundingBox: flameBoundingBox(s) });
        };
        activeApplyLayout = applyLayout;
        applyLayout();

        // Observe the canvas box rather than window resize: some resize paths
        // (viewport emulation, orientation changes) never fire the window
        // event. ResizeObserver also fires once on observe, syncing any resize
        // that happened while the shader was still loading.
        activeObserver = new ResizeObserver(() => {
          applyLayout();
          clearTimeout(settle);
          settle = window.setTimeout(applyLayout, 150);
        });
        activeObserver.observe(canvas);

        // Safety net for anything the observer misses (e.g. the library
        // rebuilding after GPU device loss with creation-time props): cheap
        // width check, no-op while the width matches what was last applied.
        widthCheck = window.setInterval(() => {
          if (window.innerWidth !== appliedFor || canvas.offsetWidth !== appliedCanvasW) {
            applyLayout();
          }
        }, 500);
      })
      .catch((err) => {
        console.error('Hero shader failed to load', err);
        showFallback();
      });
  };

  document.addEventListener('astro:page-load', init);
  desktopViewport.addEventListener('change', init);
</script>
