<script>
  /* Highlights the sidebar entry for whichever guide section is most visible.
     Re-runs per navigation (astro:page-load) because the router swaps in fresh
     nodes, and no-ops on pages without the sidebar. */
  let observer: IntersectionObserver | null = null;

  const init = () => {
    observer?.disconnect();

    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-guide-link]')];
    if (!links.length || !('IntersectionObserver' in window)) return;

    const sections = links
      .map((link) => document.querySelector(link.hash))
      .filter((section): section is Element => Boolean(section));

    observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;

        for (const link of links) {
          link.setAttribute('aria-current', String(link.hash === `#${visible.target.id}`));
        }
      },
      { rootMargin: '-20% 0px -60% 0px', threshold: [0.01, 0.15, 0.4] }
    );

    for (const section of sections) observer.observe(section);
  };

  document.addEventListener('astro:page-load', init);
</script>
