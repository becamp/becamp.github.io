                    <span>Reception venue sponsor</span>
                    <TextLink href="https://www.virginiaguesthouse.com/dining/poplar/" external class="text-[13px]">The Poplar Restaurant</TextLink>
                  </p>
                  <p class="mt-3 max-w-[60ch] text-sm leading-relaxed text-white/50">
                    Google Maps imagery is out of date and may show a construction site.
                    The Virginia Guest House is now complete.
                  </p>
                </div>
                <div class="flex flex-col gap-1.5 sm:items-end sm:text-right">
                  <span class="font-mono text-xs text-[#858fc6]">Friday reception</span>
                  <TextLink href={POPLAR_MAP} external class="text-[13px]">Open in Maps →</TextLink>
                </div>
              </div>

              <div class="grid grid-cols-1 gap-x-8 gap-y-4 border-b border-divider py-5 sm:grid-cols-[1fr_auto]">
                <div>
                  <p class="text-[1.08rem] font-medium text-white">UVA School of Data Science</p>
                  <p class={`mt-0.5 ${meta}`}>1919 Ivy Road · Charlottesville, VA 22903</p>
                  <p class={sponsorNote}>
                    <span>Main venue sponsor</span>
                    <TextLink href="https://datascience.virginia.edu/" external class="text-[13px]">UVA School of Data Science</TextLink>
                  </p>
                </div>
                <div class="flex flex-col gap-1.5 sm:items-end sm:text-right">
                  <span class="font-mono text-xs text-[#858fc6]">Pitch Night + Saturday</span>
                  <TextLink href={DATA_SCIENCE_MAP} external class="text-[13px]">Open in Maps →</TextLink>
                </div>
