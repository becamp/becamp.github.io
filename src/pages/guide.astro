        id="map-modal-close"
        type="button"
        aria-label="Close map"
        class="absolute right-2 top-2 flex size-10 items-center justify-center bg-black/55 text-2xl text-white transition-colors duration-150 hover:bg-primary hover:text-bg"
      >
        &#10005;
      </button>
      <img id="map-modal-image" src="" alt="" class="block h-auto w-full" />
      <p id="map-modal-caption" class="border-t border-white/[0.08] px-4 py-3 font-mono text-[13px] text-white/80"></p>
    </div>
