          </div>

          <div id="parking" class={sub}>
            <h3 class={subTitle}>Parking</h3>
            <p class={lead}>
              Culbreth Garage is the best free option on Saturday; Emmet/Ivy is closer but
              paid.
            </p>

            <div class={`mt-4 ${rule}`}>
              <div class="grid grid-cols-1 gap-x-8 gap-y-3 border-b border-divider py-5 sm:grid-cols-[1fr_auto]">
                <div>
