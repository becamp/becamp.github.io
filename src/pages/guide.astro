---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import TextLink from '../components/TextLink.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';
import slackIcon from '../assets/icons/slack.svg';
import dataScienceToPoplar from '../assets/images/guide/data-science-to-poplar.webp';
import culbrethToDataScience from '../assets/images/guide/culbreth-to-data-science.webp';
import emmetIvyToDataScience from '../assets/images/guide/emmet-ivy-to-data-science.webp';

const mapSearch = (query: string) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;

const POPLAR_MAP = mapSearch('The Poplar 2017 Ivy Rd Charlottesville VA 22903');
const DATA_SCIENCE_MAP = mapSearch('UVA School of Data Science 1919 Ivy Rd Charlottesville VA 22903');
const CULBRETH_MAP = mapSearch('Culbreth Parking Garage 130 Culbreth Rd Charlottesville VA 22903');
const EMMET_IVY_MAP = mapSearch('Emmet Ivy Garage 123 Emmet St N Charlottesville VA 22903');

const quickFacts = [
  { label: 'Friday', value: 'Oct 2 · 4:30–8:30pm' },
  { label: 'Saturday', value: 'Oct 3 · 9am–4pm' },
  { label: 'Main venue', value: 'UVA School of Data Science' },
  { label: 'Cost', value: 'Free, food included' },
];

const quickMaps = [
  { label: 'The Poplar', href: POPLAR_MAP },
  { label: 'School of Data Science', href: DATA_SCIENCE_MAP },
  { label: 'Culbreth Garage', href: CULBRETH_MAP },
  { label: 'Emmet/Ivy Garage', href: EMMET_IVY_MAP },
];

/* Drives the sidebar and the scroll-spy script below; `sub` entries indent under
   the major section above them, and the spy lights that major up alongside. */
const guideNav = [
  { href: '#schedule', label: 'Event Agenda' },
  { href: '#friday', label: 'Friday', sub: true },
  { href: '#saturday', label: 'Saturday', sub: true },
  { href: '#logistics', label: 'What to Know' },
  { href: '#food', label: 'Food & drinks', sub: true },
  { href: '#bring', label: 'What to bring', sub: true },
  { href: '#accessibility', label: 'Accessibility', sub: true },
  { href: '#photos', label: 'Photos & social', sub: true },
  { href: '#organizers', label: 'Organizers', sub: true },
  { href: '#slack', label: 'Cville Slack', sub: true },
  { href: '#sessions', label: 'Sessions', sub: true },
  { href: '#conduct', label: 'Code of Conduct', sub: true },
  { href: '#venue', label: 'Venue & parking' },
  { href: '#venues', label: 'Venues', sub: true },
  { href: '#parking', label: 'Parking', sub: true },
  { href: '#maps', label: 'Walking maps', sub: true },
];

const pitchProcess = [
  { step: '01', title: 'Think', body: 'Bring something you want to present, learn, share, demo, or discuss.' },
  { step: '02', title: 'Pitch', body: 'Give the room a 30-second explanation of your idea. No slides required.' },
  { step: '03', title: 'Vote', body: 'Everyone votes for the topics they most want to attend.' },
  { step: '04', title: 'Build Saturday', body: 'Volunteers arrange the top topics into five parallel tracks.' },
];

const pitchTypes = [
  { letter: 'P', title: 'Present', body: 'Something you know and want to teach, demo, or explain.' },
  { letter: 'L', title: 'Learn', body: 'Something you want to understand, with help from the room.' },
  { letter: 'S', title: 'Share', body: 'A question, experience, or problem worth a group conversation.' },
];

const saturdayFlow = [
  { time: '9:00', item: 'Doors open, breakfast & coffee' },
  { time: '9:30', item: 'Session block 1' },
  { time: '10:20', item: 'Session block 2' },
  { time: '11:10', item: 'Session block 3' },
  { time: '12:05', item: 'Lightning talks' },
  { time: '12:35', item: 'Lunch' },
  { time: '1:25', item: 'Lightning talks' },
  { time: '2:00', item: 'Session block 4' },
  { time: '2:50', item: 'Session block 5' },
  { time: '3:40', item: 'Retrospective' },
  { time: '4:05', item: 'Cleanup' },
];

const sessionCallouts = [
  {
    title: 'Lightning talks',
    body: "Ten minutes each, first come first served. If your Friday pitch didn't make the schedule, sign up in the morning and share what's on your mind.",
    accent: false,
  },
  {
    title: 'The Law of Two Feet',
    body: "Not learning or contributing where you are? Move to another session. That's the unconference working as intended — not rudeness.",
    accent: true,
  },
  {
    title: 'Stay for the retrospective',
    body: 'beCamp has evolved through attendee feedback for 20 years. The 3:40 retrospective is where we decide what to keep, change, and try next.',
    accent: false,
  },
];

const walkingMaps = [
  {
    image: dataScienceToPoplar,
    alt: 'Walking route between the School of Data Science and The Poplar.',
    caption: 'Venue ↔ venue · 3–4 min',
    full: 'School of Data Science ↔ The Poplar · 3–4 min · 0.1 mi',
  },
  {
    image: culbrethToDataScience,
    alt: 'Walking route from Culbreth Garage to the School of Data Science.',
    caption: 'Culbreth Garage → venue · 6 min',
    full: 'Culbreth Garage → School of Data Science · 6 min · 0.3 mi',
  },
  {
    image: emmetIvyToDataScience,
    alt: 'Walking route from Emmet/Ivy Garage to the School of Data Science.',
    caption: 'Emmet/Ivy Garage → venue · 2 min',
    full: 'Emmet/Ivy Garage → School of Data Science · 2 min · 0.1 mi',
  },
];

/* One place each for the repeated type and chrome, so a section reads as
   structure rather than as a wall of utility classes. */
const major = 'mt-13 scroll-mt-16 border-t border-divider pt-12';
const majorNum = 'font-mono text-sm text-primary';
const majorTitle = 'text-[clamp(1.7rem,1.2rem+1.9vw,2.25rem)] font-medium leading-[1.1] tracking-[-0.025em] text-white';
const sub = 'mt-11 scroll-mt-16';
const subTitle = 'text-[1.6rem] font-medium tracking-[-0.015em] text-white';
const itemTitle = 'mt-8 text-[1.02rem] font-semibold text-white';
const lead = 'mt-2 max-w-[66ch] text-[1.02rem] leading-relaxed text-white/80';
const body = 'max-w-[66ch] text-base leading-relaxed text-white/80';
const meta = 'font-mono text-[13px] text-[#858fc6]';
const panel = 'border border-white/[0.08] bg-white/[0.03]';
const sponsorNote = 'mt-3 flex flex-wrap items-baseline gap-x-3 gap-y-1 font-mono text-[13px] text-white/50';
const rule = 'border-t border-divider';
---

<Layout
  title="Attendee Guide — beCamp"
  description="Attendee guide for beCamp 2026 — the agenda, what to know, and the venue and parking details."
>
  <Header />
  <main>
    <div class="mx-auto grid max-w-[1120px] grid-cols-1 gap-x-16 px-5 pb-20 sm:px-10 lg:grid-cols-[210px_minmax(0,1fr)]">
      <!-- Sticky on-page nav; top-14 clears the sticky countdown bar. -->
      <aside class="hidden lg:block" aria-label="On this page">
        <div class="sticky top-14 pt-13">
          <p class="font-mono text-[13px] text-primary">On this page</p>
          <nav class="mt-4 flex flex-col">
            {guideNav.map((entry) => (
              <a
                href={entry.href}
                data-guide-link
                class={`group relative block py-1.5 font-mono text-white/60 transition-colors duration-150 hover:text-white aria-[current=true]:text-white data-[parent]:text-white ${entry.sub ? 'pl-7 text-[12px]' : 'pl-4 text-[13px]'}`}
              >
                <span
                  class={`absolute top-1/2 size-[5px] -translate-y-1/2 rotate-45 bg-divider transition-colors duration-150 group-aria-[current=true]:bg-primary group-data-[parent]:bg-primary ${entry.sub ? 'left-3.5' : 'left-0'}`}
                  aria-hidden="true"
                ></span>
                {entry.label}
              </a>
            ))}
          </nav>
        </div>
      </aside>

      <div class="min-w-0">
        <section id="summary" class="pt-13">
          <h1 class="max-w-[20ch] text-[clamp(2.1rem,1.4rem+2.6vw,3rem)] font-medium leading-[1.06] tracking-[-0.03em] text-white">
            beCamp 2026 attendee guide
          </h1>
          <p class="mt-4 max-w-[62ch] text-[1.05rem] leading-relaxed text-white/80">
            beCamp is Charlottesville's community-run tech unconference. Come Friday to
            pitch and vote; the room builds Saturday's schedule together. Here's what you
            need before you show up.
          </p>

          <div class="mt-7 grid grid-cols-[repeat(auto-fit,minmax(155px,1fr))] gap-px border border-divider bg-divider">
            {quickFacts.map((fact) => (
              <div class="bg-bg px-4 py-3">
                <p class="font-mono text-xs tracking-[0.04em] text-[#858fc6]">{fact.label}</p>
                <p class="mt-0.5 text-[0.96rem] font-medium text-white">{fact.value}</p>
              </div>
            ))}
          </div>

          <div class="mt-7 flex flex-wrap items-center gap-2 sm:gap-3">
            {quickMaps.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener"
                class={`group inline-flex items-center gap-1.5 px-3 py-2 font-mono text-[13px] text-white transition-colors duration-150 hover:border-primary hover:text-primary ${panel}`}
              >
                {link.label}
                <span class="text-[#858fc6] transition-colors duration-150 group-hover:text-primary" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>

        <!-- ── 01 Event Agenda ─────────────────────────────────────────────── -->
        <section id="schedule" class={major}>
          <div class="flex items-baseline gap-3.5">
            <span class={majorNum}>01</span>
            <h2 class={majorTitle}>Event Agenda</h2>
          </div>
          <p class={lead}>
            No pre-selected speakers — attendees build Saturday's five-track agenda on
            Friday night. Even if you can only make Saturday, come Friday to pitch and
            vote if you can.
          </p>

          <div id="friday" class={sub}>
            <h3 class={subTitle}>Friday — Reception &amp; Pitch Night</h3>

            <div class={`mt-6 ${rule}`}>
              <div class="grid grid-cols-1 gap-2 border-b border-divider py-6 sm:grid-cols-[150px_1fr] sm:gap-6">
                <p class={meta}>4:30–5:30pm</p>
                <div>
                  <h4 class="text-[1.1rem] font-medium text-white">Reception at The Poplar</h4>
                  <p class={`mt-1.5 ${body}`}>
                    Appetizers, a cash bar, and time to reconnect with Charlottesville's
                    tech community. At 5:30 we walk 3–4 minutes to the School of Data
                    Science.
                  </p>
                  <p class={`mt-3 ${body}`}>
                    The reception is held inside the Parlor, The Poplar's reception space.
                    The front-of-house staff will point you there when you arrive.
                  </p>
                  <p class={sponsorNote}>
                    <span>Reception sponsors</span>
                    <TextLink href="https://www.434.co/startup" external class="text-[13px]">434.co</TextLink>
                    <TextLink href="https://vistaly.com/" external class="text-[13px]">Vistaly</TextLink>
                  </p>
                </div>
              </div>

              <div class="grid grid-cols-1 gap-2 border-b border-divider py-6 sm:grid-cols-[150px_1fr] sm:gap-6">
                <p class={meta}>5:30–8:30pm</p>
                <div>
                  <h4 class="text-[1.1rem] font-medium text-white">
                    Pitch Night at the School of Data Science
                  </h4>
                  <p class={`mt-1.5 ${body}`}>
                    Pizza, a quick format walkthrough, sponsor thank-yous, pitches, voting,
                    and building the Saturday schedule.
                  </p>
                  <p class={sponsorNote}>
                    <span>Friday pizza sponsor</span>
                    <TextLink href="https://hardshell.ai/" external class="text-[13px]">Hardshell AI</TextLink>
                  </p>
                </div>
              </div>
            </div>

            <h4 class={itemTitle}>How Pitch Night works</h4>

            <div class={`mt-5 flex max-w-[760px] items-center gap-4 px-5 py-4 ${panel}`}>
              <span
                class="grid size-8 shrink-0 rotate-45 place-items-center border border-primary font-mono text-[15px] text-primary"
                aria-hidden="true"
              >
                <span class="-rotate-45">i</span>
              </span>
              <p class="text-[0.96rem] leading-relaxed text-white/80">
                Coming only Saturday? Come Friday if you can — your pitches and votes
                decide the day.
              </p>
            </div>

            <ol class={`mt-5 ${rule}`}>
              {pitchProcess.map((entry) => (
                <li class="grid grid-cols-[70px_1fr] gap-5 border-b border-divider py-4">
                  <span class="font-mono text-[0.95rem] text-[#858fc6]">{entry.step}</span>
                  <div>
                    <h4 class="text-[1.05rem] font-medium text-white">{entry.title}</h4>
                    <p class="mt-0.5 text-[0.96rem] leading-relaxed text-white/80">{entry.body}</p>
                  </div>
                </li>
              ))}
            </ol>

            <h4 class={itemTitle}>How to pitch</h4>
            <p class={meta}>
              A pitch is just an invitation to spend 45 minutes exploring something
              together — pick the kind that fits.
            </p>

            <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-3">
              {pitchTypes.map((type) => (
                <article class={`p-5 ${panel}`}>
                  <p class="font-mono text-[1.7rem] leading-none text-primary">{type.letter}</p>
                  <h4 class="mt-4 text-[1.05rem] font-medium text-white">{type.title}</h4>
                  <p class="mt-1.5 text-[0.95rem] leading-relaxed text-white/80">{type.body}</p>
                </article>
              ))}
            </div>

            <blockquote class="mt-7 border-l-2 border-primary py-1 pl-6">
              <p class="max-w-[60ch] text-[1.2rem] leading-[1.4] tracking-[-0.01em] text-white">
                “I don't know much about this, but I'd really like to get people together
                who do.”
              </p>
              <footer class="mt-2 font-mono text-[13px] text-[#858fc6]">
                That is a perfectly good beCamp pitch.
              </footer>
            </blockquote>

            <details class="group mt-7 max-w-[760px] border-y border-divider">
              <summary class="flex cursor-pointer list-none items-center justify-between py-4 font-mono text-[0.95rem] text-white [&::-webkit-details-marker]:hidden">
                Pitch-night checklist
                <span
                  class="text-xl text-primary transition-transform duration-150 group-open:rotate-45"
                  aria-hidden="true"
                >+</span>
              </summary>
              <ul class="list-disc pb-4 pl-5 text-base leading-relaxed text-white/80 marker:text-primary">
                <li class="mb-1.5">Give your idea a short, clear title.</li>
                <li class="mb-1.5">Write it on the card provided and mark it Present, Learn, or Share.</li>
                <li>Deliver it to the room in about 30 seconds.</li>
              </ul>
            </details>
          </div>

          <div id="saturday" class={sub}>
            <h3 class={subTitle}>Saturday — Sessions</h3>
            <p class={lead}>
              Five session blocks, five simultaneous tracks, lightning talks, lunch, and a
              closing retrospective.
            </p>

            <div class={`mt-6 ${rule}`}>
              {saturdayFlow.map((row) => (
                <div class="grid grid-cols-[100px_1fr] gap-4 border-b border-divider py-3 sm:grid-cols-[130px_1fr]">
                  <time class="font-mono text-[0.9rem] text-[#858fc6]">{row.time}</time>
                  <p class="text-base text-white">{row.item}</p>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- ── 02 What to Know ─────────────────────────────────────────────── -->
        <section id="logistics" class={major}>
          <div class="flex items-baseline gap-3.5">
            <span class={majorNum}>02</span>
            <h2 class={majorTitle}>What to Know</h2>
          </div>
          <p class={lead}>
            Meals, gear, access, how the sessions work, and the people to find if you have
            a question.
          </p>

          <div id="food" class={sub}>
            <h3 class={subTitle}>Food &amp; drinks</h3>
            <p class={lead}>
              You won't need to leave for meals.{' '}
              <strong class="font-medium text-white">Friday:</strong> appetizers and a cash
              bar at The Poplar; pizza and non-alcoholic drinks at Pitch Night.{' '}
              <strong class="font-medium text-white">Saturday:</strong> breakfast, coffee
              and tea, lunch, and cold drinks.
            </p>
            <p class={`mt-3 ${meta}`}>
              Vegetarian and vegan options available — contact the organizers about any
              dietary need.
            </p>
            <p class={sponsorNote}>
              <span>Friday food &amp; drink sponsors</span>
              <TextLink href="https://hardshell.ai/" external class="text-[13px]">Hardshell AI</TextLink>
              <TextLink href="http://cvaiex.org/" external class="text-[13px]">CvAIEx</TextLink>
            </p>
            <p class={sponsorNote}>
              <span>Saturday food &amp; drink sponsors</span>
              <TextLink href="https://www.carsonsweet.com/" external class="text-[13px]">Carson Sweet</TextLink>
              <TextLink href="https://spiff.works/" external class="text-[13px]">SpiffWorks</TextLink>
              <TextLink href="https://jxf.me/" external class="text-[13px]">JFX</TextLink>
              <TextLink href="https://www.controlaltrecycle.com/" external class="text-[13px]">Control Alt Recycle</TextLink>
              <TextLink href="https://www.fraccel.com/" external class="text-[13px]">Fraccel</TextLink>
            </p>
          </div>

          <div class="grid grid-cols-1 gap-5 lg:grid-cols-2 lg:gap-10">
            <div id="bring" class={sub}>
              <h3 class={subTitle}>What to bring</h3>
              <ul class="mt-3 list-disc pl-5 text-base leading-relaxed text-white/80 marker:text-primary">
                <li class="mb-1.5">Laptop or notebook</li>
                <li class="mb-1.5">Power cord and charger</li>
                <li class="mb-1.5">Reusable water bottle, if you use one</li>
                <li>An idea, question, or topic you're curious about</li>
              </ul>
              <p class={`mt-4 ${meta}`}>
                Dress is casual — come ready to move between sessions.
              </p>
              <p class={sponsorNote}>
                <span>T-shirts sponsored by</span>
                <TextLink href="https://www.ga-intelligence.com/" external class="text-[13px]">GA Intelligence</TextLink>
              </p>
            </div>

            <div id="accessibility" class={sub}>
              <h3 class={subTitle}>Accessibility</h3>
              <p class={`mt-3 ${body}`}>
                The School of Data Science includes hearing loops in the Hub and
                classrooms, gender-neutral restrooms, an ADA-accessible shower, and a
                wellness and affirmation space.
              </p>
              <p class={`mt-3 ${meta}`}>
                Have another need?{' '}
                <TextLink href="mailto:ozanzal+becamp@gmail.com" class="text-[13px]">Contact the organizers</TextLink>{' '}
                and we'll do what we reasonably can.
              </p>
            </div>
          </div>

          <div id="photos" class={sub}>
            <h3 class={subTitle}>Photos &amp; social</h3>
            <p class="mt-3 font-mono text-[2rem] leading-none tracking-[-0.04em] text-primary">#beCamp</p>
            <p class={`mt-3 ${body}`}>
              Photograph the ideas, conversations, and moments that make beCamp special,
              then share them on social media with{' '}
              <strong class="font-medium text-white">#beCamp</strong>.
            </p>
          </div>

          <div id="organizers" class={sub}>
            <h3 class={subTitle}>Organizers</h3>
            <p class={lead}>
              Questions during the event? Find Patrick or Owen — or reach out ahead of
              time.
            </p>

            <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
              <article class={`p-5 ${panel}`}>
                <h4 class="text-[1.15rem] font-medium text-white">Patrick Harrison</h4>
                <p class={`mt-1.5 ${meta}`}>beCamp organizer</p>
                <TextLink href="https://www.linkedin.com/in/patrick-harrison/" external class="mt-4 inline-block text-[13px]">
                  Connect on LinkedIn →
                </TextLink>
              </article>
              <article class={`p-5 ${panel}`}>
                <h4 class="text-[1.15rem] font-medium text-white">Owen Zanzal</h4>
                <p class={`mt-1.5 ${meta}`}>beCamp organizer</p>
                <div class="mt-4 grid gap-1.5 font-mono text-[13px] leading-normal">
                  <a href="mailto:ozanzal@gmail.com" class="text-white transition-colors duration-150 hover:text-primary">
                    ozanzal@gmail.com
                  </a>
                  <p>
                    <a href="tel:+12034175355" class="text-white transition-colors duration-150 hover:text-primary">203-417-5355</a>
                    <span class="text-[#858fc6]"> · text preferred</span>
                  </p>
                </div>
                <TextLink href="https://www.linkedin.com/in/owenzanzal/" external class="mt-4 inline-block text-[13px]">
                  Connect on LinkedIn →
                </TextLink>
              </article>
            </div>
          </div>

          <div id="slack" class={sub}>
            <h3 class={subTitle}>Cville Slack</h3>
            <p class={lead}>
              You can chat with organizers and attendees on the #beCamp Slack channel.
            </p>

            <div class={`mt-5 flex max-w-[760px] items-start gap-4 px-5 py-4 ${panel}`}>
              <img src={slackIcon.src} alt="" class="mt-0.5 size-6 shrink-0 opacity-80" />
              <div>
                <p class="font-mono text-[0.95rem] text-white">#beCamp</p>
                <p class="mt-2 text-[0.96rem] leading-relaxed text-white/80">
                  Not on Cville Slack yet? Email{' '}
                  <TextLink href="mailto:ozanzal+slack@gmail.com" class="text-[0.96rem]">ozanzal+slack@gmail.com</TextLink>{' '}
                  for an invitation. Expect confirmation within 24 hours.
                </p>
              </div>
            </div>
          </div>

          <div id="sessions" class={sub}>
            <h3 class={subTitle}>Sessions</h3>
            {sessionCallouts.map((callout) => (
              <div
                class={`mt-5 max-w-[760px] p-5 ${callout.accent ? 'border border-primary/50 bg-primary/5' : panel}`}
              >
                <h4 class="text-[1.1rem] font-medium text-white">{callout.title}</h4>
                <p class="mt-1.5 text-[0.96rem] leading-relaxed text-white/80">{callout.body}</p>
              </div>
            ))}
          </div>

          <div id="conduct" class={sub}>
            <h3 class={subTitle}>Code of Conduct</h3>
            <p class={lead}>
              beCamp follows the Charlottesville Community Code of Conduct. By joining this
              community, you belong here — and so does the next person.
            </p>

            <div class="mt-4 grid grid-cols-1 gap-5 lg:grid-cols-2 lg:gap-8">
              <div>
                <h4 class={itemTitle}>What we expect</h4>
                <ul class="mt-2 list-disc pl-5 text-base leading-relaxed text-white/80 marker:text-primary">
                  <li class="mb-1.5">Treat people with consideration and respect.</li>
                  <li class="mb-1.5">Welcome others in and make room for other voices.</li>
                  <li class="mb-1.5">Respect differences, boundaries, privacy, and digital security.</li>
                  <li>Adjust if someone says your behavior is making the space less welcoming.</li>
                </ul>
              </div>
              <div>
                <h4 class={itemTitle}>What isn't welcome</h4>
                <ul class="mt-2 list-disc pl-5 text-base leading-relaxed text-white/80 marker:text-primary">
                  <li class="mb-1.5">Discrimination, harassment, intimidation, stalking, or threats.</li>
                  <li class="mb-1.5">Unwelcome contact, or photography and recording without consent.</li>
                  <li>Doxxing, digital-security attacks, or sustained disruption.</li>
                </ul>
              </div>
            </div>

            <div class={`mt-6 flex max-w-[760px] items-center gap-4 px-5 py-4 ${panel}`}>
              <span
                class="grid size-8 shrink-0 rotate-45 place-items-center border border-primary font-mono text-[15px] text-primary"
                aria-hidden="true"
              >
                <span class="-rotate-45">!</span>
              </span>
              <p class="text-[0.96rem] leading-relaxed text-white/80">
                See something? Contact an organizer — even if you're unsure it rises to a
                violation. For an immediate emergency, call 911.
