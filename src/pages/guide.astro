<script>
  /* Two behaviours, both re-initialised per navigation (astro:page-load) because
     the router swaps in fresh nodes: the sidebar scroll-spy and the map
     lightbox. Both no-op on pages without their markup. */
  let observer: IntersectionObserver | null = null;
  let modal: HTMLElement | null = null;

  const setModalOpen = (open: boolean) => {
    modal?.classList.toggle('hidden', !open);
    modal?.classList.toggle('flex', open);
    document.body.classList.toggle('overflow-hidden', open);
    if (!open) {
      const image = document.getElementById('map-modal-image') as HTMLImageElement | null;
      if (image) image.src = '';
    }
  };

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) setModalOpen(false);
  });

  const initScrollSpy = () => {
    observer?.disconnect();

    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-guide-link]')];
    if (!links.length || !('IntersectionObserver' in window)) return;

    const sections = links
      .map((link) => document.querySelector(link.hash))
      .filter((section): section is Element => Boolean(section));

    /* A sub-section lights its own entry and the major heading above it, so the
       reader can see which of the three parts of the guide they are inside. */
    const mark = (id: string) => {
      const index = links.findIndex((link) => link.hash === `#${id}`);
      for (const link of links) {
        link.setAttribute('aria-current', 'false');
        link.removeAttribute('data-parent');
      }
      if (index < 0) return;
      links[index].setAttribute('aria-current', 'true');
      if (!links[index].classList.contains('pl-7')) return;
      for (let i = index - 1; i >= 0; i--) {
        if (!links[i].classList.contains('pl-7')) {
          links[i].setAttribute('data-parent', '');
          return;
        }
      }
    };

    observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) mark(visible.target.id);
      },
      { rootMargin: '-15% 0px -70% 0px', threshold: [0.01, 0.2] }
    );

    for (const section of sections) observer.observe(section);
  };

  const initLightbox = () => {
    modal = document.getElementById('map-modal');
    const image = document.getElementById('map-modal-image') as HTMLImageElement | null;
    const caption = document.getElementById('map-modal-caption');
    const closeBtn = document.getElementById('map-modal-close');

    for (const thumb of document.querySelectorAll<HTMLElement>('[data-map-thumb]')) {
      thumb.addEventListener('click', () => {
        if (!image) return;
        image.src = thumb.dataset.full ?? '';
        image.alt = thumb.dataset.alt ?? '';
        if (caption) caption.textContent = thumb.dataset.caption ?? '';
        setModalOpen(true);
        closeBtn?.focus();
      });
    }

    closeBtn?.addEventListener('click', () => setModalOpen(false));
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) setModalOpen(false);
    });
  };

  document.addEventListener('astro:page-load', () => {
    initScrollSpy();
    initLightbox();
  });
</script>
