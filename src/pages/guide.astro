            <h3 class={subTitle}>Venues</h3>

            <div class={`mt-4 ${rule}`}>
              <div class="grid grid-cols-1 gap-x-8 gap-y-4 border-b border-divider py-5 sm:grid-cols-[1fr_auto]">
                <div>
                  <p class="text-[1.08rem] font-medium text-white">The Poplar</p>
