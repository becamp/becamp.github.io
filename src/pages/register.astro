---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import check from '../assets/icons/check.svg';
import { SPONSOR_EMAIL } from '../lib/sponsorship';

/* Submissions post to /api/register, which maps these field names to Airtable columns. */
const attendanceOptions = [
  {
    id: 'attend-reception',
    checked: true,
    label: "I'll be attending the reception at The Poplar Restaurant on Friday Oct 2nd from 4:30pm -> 5:30pm",
    detail: 'Appetizers will be served, and there will be a cash bar for drinks.',
  },
  {
    id: 'attend-friday',
    checked: true,
    label: "I'll be attending Pitch Night on Friday Oct 2nd from 5:30pm -> 8:30pm",
    detail:
      'Pitch Night is open to everyone; however, we ask that you only pitch and/or vote on pitches if you are coming to Saturday sessions. Pizza will be provided.',
  },
  {
    id: 'attend-saturday',
    checked: true,
    label: "I'll be attending Sessions on Saturday Oct 3rd from 9am -> 4pm",
    detail:
      'If you want to attend Saturday Sessions, we ask that you also attend Pitch Night. Breakfast, lunch, and beverages will be served.',
  },
  {
    id: 'attendee-directory',
    checked: false,
    label: 'I would like to be listed in the Attendee Directory',
    detail:
      'Leave this unchecked if you do not want to be listed on the becamp.org website. If listed, your profile image will be grabbed from https://en.gravatar.com/, so go there to make any desired changes for the avatar associated with your email address.',
  },
];

const volunteerOptions = [
  { id: 'volunteer-friday', checked: false, label: 'Yes, I can help out on Friday!', detail: 'We need and love our volunteers!' },
  { id: 'volunteer-saturday', checked: false, label: 'Yes, I can help out on Saturday!', detail: 'We need and love our volunteers!' },
];

/* reCAPTCHA v3 activates when PUBLIC_RECAPTCHA_SITE_KEY is set; the honeypot works regardless. */
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;

/* Must match HONEYPOT_FIELD in api/register.ts. Deliberately meaningless — a
   field named "website" gets autofilled by password managers, which silently
   threw real registrations away behind a success banner. */
const honeypotField = 'bc-hp';

/* The endpoint reports why it failed via ?reason=; each gets copy the visitor
   can act on instead of one undifferentiated "try again". */
const errorCopy: Record<string, string> = {
  missing: 'We need both a name and an email address to register you. Please fill those in and submit again.',
  captcha: "Our spam check flagged this submission. If you're a human — and you almost certainly are — email us and we'll register you by hand.",
  airtable: "We couldn't save your registration just now. Please try again in a minute.",
  config: "The registration system is misconfigured on our end. Please email us and we'll sort it out.",
  server: 'Something went wrong on our end. Please try again.',
};
const DEFAULT_ERROR = 'Something went wrong submitting your registration. Please try again.';

/* The site is static; submissions go to the registration function hosted on Vercel. */
const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || '/api/register';

/* Flip to false when T-shirts run out — hides the field entirely. */
const shirtsAvailable = true;

/* Values must match the Airtable "T-shirt Size" single-select options exactly. */
const shirtSizes = ['no thanks', 'small', 'medium', 'large', 'x-large'];
---

<Layout title="Register — beCamp" countdown={false}>
  <Header />
  <main class="relative overflow-hidden">
    <div class="pointer-events-none relative px-5 pt-20 pb-10 sm:px-20">
      <p class="font-mono text-base text-primary">October 2–3 in Charlottesville, VA</p>
      <h1 class="mt-5 text-5xl font-medium leading-none tracking-[-0.64px] text-white sm:text-[64px]">
        BeCamp 2026 Registration
      </h1>
      <p class="mt-5 text-xl text-[#a3adc6]">Woo hoo! BeCamp's almost here!</p>
    </div>

    <div id="form-status-success" class="mx-5 mb-6 hidden max-w-[800px] border border-primary bg-primary/10 px-5 py-4 text-base text-white sm:mx-20">
      You're registered! See you in October.
    </div>
    <div
      id="form-status-error"
      data-error-copy={JSON.stringify(errorCopy)}
      class="mx-5 mb-6 hidden max-w-[800px] border border-red-400 bg-red-400/10 px-5 py-4 text-base text-white sm:mx-20"
    >
      <p id="form-status-error-message">{DEFAULT_ERROR}</p>
      <p class="mt-2 text-sm text-[#a3adc6]">
        Still stuck? Email{' '}
        <a href={`mailto:${SPONSOR_EMAIL}?subject=${encodeURIComponent('beCamp: registration trouble')}`} class="text-primary underline">{SPONSOR_EMAIL}</a>{' '}
        and we'll register you directly. Your details are kept below so you don't have to retype them.
      </p>
    </div>

    <form
      id="registration-form"
      method="POST"
      action={formEndpoint}
      data-astro-reload
      data-honeypot={honeypotField}
      class="relative mx-5 mb-24 flex max-w-[800px] flex-col gap-9 border border-white/15 bg-[#0b0e2d] p-6 drop-shadow-[0px_16px_16px_rgba(0,0,0,0.25)] sm:mx-20 sm:p-12"
    >
      <div class="absolute -left-[9999px] top-0" aria-hidden="true">
        <label for={honeypotField}>Leave this field empty</label>
        <input id={honeypotField} name={honeypotField} type="text" tabindex="-1" autocomplete="off" />
      </div>
      <input type="hidden" name="recaptcha-token" id="recaptcha-token" />
      <fieldset class="flex flex-col gap-6">
        <legend class="mb-6 font-mono text-lg font-semibold text-primary">1. Attendee Information</legend>
        <div class="flex flex-col gap-3">
          <label for="guest-name" class="font-mono text-sm font-semibold text-white">
            Guest Name <span class="text-primary">*</span>
          </label>
          <input
            id="guest-name"
            name="name"
            type="text"
            required
            placeholder="First and last name, please"
            class="h-[52px] w-full rounded-lg border border-white/15 bg-white/5 px-4 text-base text-white placeholder:text-[#a3adc6]"
          />
        </div>
        <div class="flex flex-col gap-3">
          <label for="email" class="font-mono text-sm font-semibold text-white">
            Email <span class="text-primary">*</span>
          </label>
          <input
            id="email"
            name="email"
            type="email"
            required
            placeholder="your.email@example.com"
            class="h-[52px] w-full rounded-lg border border-white/15 bg-white/5 px-4 text-base text-white placeholder:text-[#a3adc6]"
          />
        </div>
        {shirtsAvailable && (
          <div class="flex flex-col gap-3">
            <label for="shirt-size" class="font-mono text-sm font-semibold text-white">
              T-shirt Size <span class="font-normal text-[#a3adc6]">(free, while supplies last)</span>
            </label>
            <div class="relative">
              <select
                id="shirt-size"
                name="shirt-size"
                class="h-[52px] w-full cursor-pointer appearance-none rounded-lg border border-white/15 bg-white/5 px-4 text-base text-white [&>option]:bg-[#0b0e2d]"
              >
                {shirtSizes.map((size) => (
                  <option value={size}>{size}</option>
                ))}
              </select>
              <svg
                class="pointer-events-none absolute right-4 top-1/2 size-4 -translate-y-1/2 text-white"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </div>
          </div>
        )}
      </fieldset>

      <hr class="border-divider" />

      <fieldset class="flex flex-col gap-7">
        <legend class="mb-7 font-mono text-lg font-semibold text-primary">2. Event Attendance</legend>
        {attendanceOptions.map((option) => (
          <label for={option.id} class="flex cursor-pointer items-start gap-4">
            <span class="relative mt-0.5">
              <input
                id={option.id}
                name={option.id}
                type="checkbox"
                checked={option.checked}
                class="peer size-6 cursor-pointer appearance-none rounded-md border border-white/15 bg-white/5 checked:border-primary checked:bg-primary"
              />
              <img src={check.src} alt="" class="pointer-events-none absolute left-[5px] top-[5px] hidden size-3.5 peer-checked:block" />
            </span>
            <span class="flex flex-col gap-1.5">
              <span class="text-base font-medium text-white">{option.label}</span>
              <span class="text-sm leading-relaxed text-[#a3adc6]">{option.detail}</span>
            </span>
          </label>
        ))}
      </fieldset>

      <hr class="border-divider" />

      <fieldset class="flex flex-col gap-6">
        <legend class="mb-6 font-mono text-lg font-semibold text-primary">3. Volunteering Opportunities</legend>
        {volunteerOptions.map((option) => (
          <label for={option.id} class="flex cursor-pointer items-start gap-4">
            <span class="relative mt-0.5">
              <input
                id={option.id}
                name={option.id}
                type="checkbox"
                checked={option.checked}
                class="peer size-6 cursor-pointer appearance-none rounded-md border border-white/15 bg-white/5 checked:border-primary checked:bg-primary"
              />
              <img src={check.src} alt="" class="pointer-events-none absolute left-[5px] top-[5px] hidden size-3.5 peer-checked:block" />
            </span>
            <span class="flex flex-col gap-1.5">
              <span class="text-base font-medium text-white">{option.label}</span>
              <span class="text-sm leading-relaxed text-[#a3adc6]">{option.detail}</span>
            </span>
          </label>
        ))}
      </fieldset>

      <div class="flex flex-col gap-5 pt-3">
        <button id="registration-submit" type="submit" class="w-full bg-primary px-8 py-4 font-mono text-lg font-semibold text-bg disabled:opacity-60">
          Submit Registration
        </button>
      </div>
    </form>
  </main>
  <Footer />

  {recaptchaSiteKey && (
    <script is:inline src={`https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`}></script>
  )}
  {recaptchaSiteKey && (
    <script is:inline define:vars={{ recaptchaSiteKey }}>
      /* Inline scripts don't re-execute on client-side navigation, so binding
         happens per page via astro:page-load, guarded against double-binding. */
      const bindRecaptcha = () => {
        const form = document.getElementById('registration-form');
        const tokenInput = document.getElementById('recaptcha-token');
        if (!form || !tokenInput || form.dataset.recaptchaBound) return;
        form.dataset.recaptchaBound = '1';
        form.addEventListener('submit', (e) => {
          if (tokenInput.value) return;
          /* Content blockers can keep the reCAPTCHA script from loading at all.
             Fall through to a plain submit — the server treats a missing token
             as "unverified", not as "bot", so the registration still lands. */
          if (typeof grecaptcha === 'undefined') return;
          e.preventDefault();
          /* Both the timeout and the promise can reach the finish line; without
             this the form POSTs twice and Airtable gets a duplicate row. */
          let submitted = false;
          const go = () => {
            if (submitted) return;
            submitted = true;
            form.submit();
          };
          /* "unavailable" tells the server the script never answered, so it
             accepts the registration unverified rather than spending a round
             trip on a token Google is certain to reject. A cold first load can
             genuinely take this long, and that used to cost a registration. */
          const proceed = () => {
            if (!tokenInput.value) tokenInput.value = 'unavailable';
            go();
          };
          const fallback = setTimeout(proceed, 5000);
          grecaptcha.ready(() => {
            grecaptcha
              .execute(recaptchaSiteKey, { action: 'register' })
              .then((token) => {
                clearTimeout(fallback);
                if (submitted) return;
                tokenInput.value = token;
                go();
              })
              .catch(() => {
                clearTimeout(fallback);
                proceed();
              });
          });
        });
      };
      bindRecaptcha();
      document.addEventListener('astro:page-load', bindRecaptcha);
    </script>
  )}
</Layout>

<script>
  /* A failed submit used to redirect back to an empty form, so anyone who hit
     an error had to retype their name, email and eight checkboxes — which is
     how people end up double-submitting or giving up. Values are held in
     sessionStorage across the round trip and dropped once registration lands. */
  const STASH_KEY = 'becamp:registration';
  /* Never persist the single-use captcha token or the honeypot. */
  const skipField = (form: HTMLFormElement, name: string) =>
    !name || name === 'recaptcha-token' || name === form.dataset.honeypot;

  type Field = HTMLInputElement | HTMLSelectElement;
  const fieldsOf = (form: HTMLFormElement) =>
    Array.from(form.elements).filter(
      (el): el is Field =>
        (el instanceof HTMLInputElement || el instanceof HTMLSelectElement) &&
        !skipField(form, el.name)
    );

  const stash = (form: HTMLFormElement) => {
    const data: Record<string, string | boolean> = {};
    for (const el of fieldsOf(form)) {
      data[el.name] = el instanceof HTMLInputElement && el.type === 'checkbox' ? el.checked : el.value;
    }
    try {
      sessionStorage.setItem(STASH_KEY, JSON.stringify(data));
    } catch {
      /* private mode or a full quota — worth losing the convenience, not the submit */
    }
  };

  const restore = (form: HTMLFormElement) => {
    let data: Record<string, string | boolean> | null = null;
    try {
      data = JSON.parse(sessionStorage.getItem(STASH_KEY) ?? 'null');
    } catch {
      /* unreadable stash is the same as no stash */
    }
    if (!data) return;
    for (const el of fieldsOf(form)) {
      if (!(el.name in data)) continue;
      const value = data[el.name];
      if (el instanceof HTMLInputElement && el.type === 'checkbox') el.checked = Boolean(value);
      else el.value = String(value);
    }
  };

  const clearStash = () => {
    try {
      sessionStorage.removeItem(STASH_KEY);
    } catch {
      /* nothing to do */
    }
  };

  const bindForm = () => {
    const form = document.getElementById('registration-form') as HTMLFormElement | null;
    if (!form || form.dataset.stashBound) return;
    form.dataset.stashBound = '1';
    form.addEventListener('submit', () => {
      stash(form);
      /* The reCAPTCHA path holds the POST for up to five seconds; an impatient
         second click in that window would post the form twice. */
      const button = document.getElementById('registration-submit') as HTMLButtonElement | null;
      if (button) {
        button.disabled = true;
        button.textContent = 'Submitting…';
      }
    });
  };

  const showStatus = () => {
    const params = new URLSearchParams(location.search);
    const status = params.get('status');
    if (status !== 'success' && status !== 'error') return;
    const banner = document.getElementById(`form-status-${status}`);
    if (status === 'error') {
      /* The endpoint names the failure via ?reason=; anything unrecognised
         keeps the generic copy already in the markup. */
      const message = document.getElementById('form-status-error-message');
      const copy = JSON.parse(banner?.dataset.errorCopy ?? '{}');
      const reason = params.get('reason') ?? '';
      if (message && copy[reason]) message.textContent = copy[reason];
      const form = document.getElementById('registration-form') as HTMLFormElement | null;
      if (form) restore(form);
    } else {
      clearStash();
    }
    banner?.classList.remove('hidden');
    banner?.scrollIntoView({ block: 'center' });
  };

  /* Fires on initial load and after every client-side navigation; no-ops on
     pages without a status param or banner. */
  document.addEventListener('astro:page-load', () => {
    bindForm();
    showStatus();
  });
</script>
