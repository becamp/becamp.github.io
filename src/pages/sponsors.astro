---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import SponsorPlaceholder from '../components/SponsorPlaceholder.astro';
import CtaSection from '../components/CtaSection.astro';
import Footer from '../components/Footer.astro';
import externalLinkIcon from '../assets/icons/external-link.svg';
import { getSponsors } from '../lib/airtable';
import { BECOME_SPONSOR_HREF, BECOME_PREMIER_HREF } from '../lib/sponsorship';

const { premier, regular } = await getSponsors();

const hostname = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---

<Layout title="Sponsors — beCamp">
  <Header />
  <main>
    <PageHero label="Our Sponsors" title="The people and organizations who make this free">
      <p class="mt-8 max-w-[463px] text-base leading-relaxed text-white/80">
        beCamp wouldn't happen without these sponsors. Presented alphabetically, they
        support Charlottesville's tech community and help keep the event free for
        everyone who shows up.
      </p>
      <Button href="/register" class="mt-8 w-full">Register now</Button>
    </PageHero>

    <section class="px-5 sm:px-20 pt-8">
      <h2 class="text-4xl font-medium tracking-[-0.36px] text-white">Premier Sponsors</h2>

      {premier.length > 0 ? (
        <div class="mt-12 flex flex-col gap-12 pb-12">
          {premier.map((sponsor) => (
            <div id={sponsor.slug} class="flex scroll-mt-16 flex-col gap-6 lg:flex-row lg:gap-16">
              <div class="flex h-[185px] w-full max-w-[413px] shrink-0 items-center justify-center border border-white/[0.08] bg-white/[0.03] p-8">
                {sponsor.logo ? (
                  <Image
                    src={sponsor.logo.url}
                    width={sponsor.logo.width}
                    height={sponsor.logo.height}
                    alt={sponsor.name}
                    class="h-18 w-56 max-w-full object-contain brightness-0 invert"
                  />
                ) : (
                  <span class="text-xl font-medium text-white">{sponsor.name}</span>
                )}
              </div>
              <div class="flex max-w-[463px] flex-col justify-between gap-4">
                <p class="text-base leading-relaxed text-white/80">{sponsor.writeup}</p>
                {sponsor.url && (
                  <a
                    href={sponsor.url}
                    target="_blank"
                    rel="noopener"
                    class="flex items-center gap-2 font-mono text-base text-link hover:underline"
                  >
                    {hostname(sponsor.url)}
                    <img src={externalLinkIcon.src} alt="" class="size-4" />
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      ) : null}

      <SponsorPlaceholder href={BECOME_PREMIER_HREF} label="Click to become a Premier Sponsor" class="mt-12 h-[185px] w-full max-w-[413px]" />

      <h2 class="mt-24 text-xl font-medium tracking-[-0.2px] text-white">Sponsors</h2>
      <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-3">
        {regular.map((sponsor) => (
          <a
            id={sponsor.slug}
            href={sponsor.url}
            target="_blank"
            rel="noopener"
            class="flex h-32 scroll-mt-16 items-center justify-center border border-white/[0.08] bg-white/[0.03] p-6 transition-colors duration-150 hover:border-primary/60 hover:bg-white/[0.08]"
          >
            {sponsor.logo ? (
              <Image
                src={sponsor.logo.url}
                width={sponsor.logo.width}
                height={sponsor.logo.height}
                alt={sponsor.name}
                class="h-14 w-44 max-w-full object-contain brightness-0 invert"
              />
            ) : (
              <span class="text-center text-lg font-medium text-white">{sponsor.name}</span>
            )}
          </a>
        ))}
        <SponsorPlaceholder href={BECOME_SPONSOR_HREF} label="Click to become a sponsor" class="h-32" />
      </div>
    </section>

    <CtaSection />
  </main>
  <Footer />
</Layout>
