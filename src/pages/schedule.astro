---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Button from '../components/Button.astro';
import SponsorPlaceholder from '../components/SponsorPlaceholder.astro';
import CtaSection from '../components/CtaSection.astro';
import Footer from '../components/Footer.astro';
import infoIcon from '../assets/icons/info.svg';

/* Times are placeholders until the real 2026 schedule is set the night of Nov 14. */
const fridayRows = [
  { time: '4:30pm', title: 'Volunteers arrive' },
  { time: '4:30pm', title: 'Doors open' },
  { time: '4:30pm', title: 'Dinner arrives' },
  { time: '4:30pm', title: 'Intros & Haiku, Sponsor highlights, Topic pitches, Saturday schedule posted' },
];

/* slots: 3 = three parallel session placeholders, 1 = single full-width block */
const saturdayRows = [
  { time: '4:30pm', slots: 3 },
  { time: '4:30pm', slots: 3 },
  { time: '4:30pm', slots: 3 },
  { time: '4:30pm', slots: 1 },
  { time: '4:30pm', slots: 1 },
  { time: '4:30pm', slots: 1 },
  { time: '4:30pm', slots: 3 },
  { time: '4:30pm', slots: 3 },
  { time: '4:30pm', slots: 1 },
  { time: '4:30pm', slots: 1 },
];
---

<Layout title="Schedule — beCamp">
  <Header />
  <main>
    <PageHero label="2026 Schedule" title="Voted on and finalized the evening of November 14th">
      <div class="mt-12 flex w-full items-center gap-5 border border-white/25 bg-white/[0.09] px-5 py-6">
        <img src={infoIcon.src} alt="" class="size-8 shrink-0 opacity-80" />
        <p class="text-base leading-relaxed text-white/80">
          Topics get filled in by whoever shows up the night before. Empty slots are the
          point, not a bug.
          <a href="/faqs" class="underline">How are topics decided?</a>
        </p>
      </div>
      <Button href="/register" class="mt-6 w-full">Register now [R]</Button>
    </PageHero>

    <section class="px-5 sm:px-20 pt-16">
      <SectionLabel class="text-sm">Friday, November 14th</SectionLabel>
      <h2 class="mt-3 text-4xl font-medium tracking-[-0.36px] text-white">
        The Looking Glass Art Bar
      </h2>
      <p class="mt-4 max-w-[567px] text-base leading-relaxed text-white/80">
        Anyone can propose a session about something they would like to teach, share,
        demonstrate, discuss, or understand better. Topics may be technical, creative,
        professional, civic, practical, or completely unexpected.
      </p>

      <div class="mt-12 divide-y divide-divider border-y border-divider">
        {fridayRows.map((row) => (
          <div class="flex flex-col gap-2 py-6 sm:flex-row sm:items-baseline sm:gap-0">
            <p class="w-40 shrink-0 text-lg font-medium tracking-[-0.18px] text-[#858fc6]">{row.time}</p>
            <p class="text-2xl font-medium tracking-[-0.24px] text-white">{row.title}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="px-5 sm:px-20 pt-24">
      <SectionLabel class="text-sm">Saturday, November 15th</SectionLabel>
      <h2 class="mt-3 text-4xl font-medium tracking-[-0.36px] text-white">
        UVA School of Business
      </h2>
      <p class="mt-4 max-w-[522px] text-base leading-relaxed text-white/80">
        Saturday is a full day of community-selected conversations, workshops,
        demonstrations, and discoveries.
      </p>

      <div class="mt-12 divide-y divide-divider border-y border-divider">
        {saturdayRows.map((row) => (
          <div class="flex flex-col gap-3 py-5 sm:flex-row sm:items-center sm:gap-0">
            <p class="w-40 shrink-0 text-lg font-medium tracking-[-0.18px] text-[#858fc6]">{row.time}</p>
            {row.slots === 3 ? (
              <div class="grid flex-1 grid-cols-1 gap-5 sm:grid-cols-3">
                <SponsorPlaceholder class="h-[65px]" />
                <SponsorPlaceholder class="h-[65px]" />
                <SponsorPlaceholder class="h-[65px]" />
              </div>
            ) : (
              <SponsorPlaceholder class="h-[65px] flex-1" />
            )}
          </div>
        ))}
      </div>
    </section>

    <CtaSection />
  </main>
  <Footer />
</Layout>
