---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Button from '../components/Button.astro';
import TextLink from '../components/TextLink.astro';
import SponsorPlaceholder from '../components/SponsorPlaceholder.astro';
import CtaSection from '../components/CtaSection.astro';
import Footer from '../components/Footer.astro';
import infoIcon from '../assets/icons/info.svg';
import { getSaturdaySchedule, TIME_SLOTS } from '../lib/airtable';

const pitchNightRows = [
  { time: '4:00pm', title: 'Volunteers arrive' },
  { time: '5:30pm', title: 'Doors open' },
  { time: '5:30pm', title: 'Dinner arrives' },
  { time: '6:00pm', title: 'Intros & Haiku, Sponsor highlights, Topic pitches, Saturday schedule posted' },
];

/* Sessions come from the Airtable "Saturday Schedule" table at build time. Slots
   without sessions stay visible as open placeholders — empty slots are the point. */
const sessions = await getSaturdaySchedule();
const scheduleRows = TIME_SLOTS.map((slot) => ({
  time: slot,
  sessions: sessions.filter((s) => s.time === slot),
}));

/* slots: 3 = three parallel session placeholders, 1 = single full-width block */
const placeholderRows = [
  { time: 'TBD', slots: 3 },
  { time: 'TBD', slots: 3 },
  { time: 'TBD', slots: 3 },
  { time: 'TBD', slots: 1 },
  { time: 'TBD', slots: 1 },
  { time: 'TBD', slots: 1 },
  { time: 'TBD', slots: 3 },
  { time: 'TBD', slots: 3 },
  { time: 'TBD', slots: 1 },
  { time: 'TBD', slots: 1 },
];
---

<Layout title="Schedule — beCamp">
  <Header />
  <main>
    <PageHero label="2026 Schedule" title="Voted on and finalized the evening of October 2nd">
      <div class="mt-12 flex w-full items-center gap-5 border border-white/[0.08] bg-white/[0.03] px-5 py-6 backdrop-blur-md">
        <img src={infoIcon.src} alt="" class="size-8 shrink-0 opacity-80" />
        <p class="text-base leading-relaxed text-white/80">
          Topics get filled in by whoever shows up the night before. Empty slots are the
          point, not a bug.{' '}<a href="/faqs#how-are-topics-decided" class="underline">How are topics decided?</a>
        </p>
      </div>
      <Button href="/register" class="mt-6 w-full">Register now</Button>
    </PageHero>

    <section class="px-5 sm:px-20 pt-16">
      <SectionLabel class="text-sm">Friday, October 2nd</SectionLabel>

      <div class="mt-3">
        <h2 class="text-4xl font-medium tracking-[-0.36px] text-white">
          Reception at The Poplar Restaurant
        </h2>
        <p class="mt-2 font-mono text-lg text-[#858fc6]">4:30pm – 5:30pm</p>
        <p class="mt-4 max-w-[567px] text-base leading-relaxed text-white/80">
          Cash bar, networking, and appetizers at The Poplar Restaurant at The Virginia
          Guest House, 2017 Ivy Rd.
        </p>
        <div class="mt-4 flex flex-wrap gap-x-10 gap-y-2">
          <TextLink href="https://www.virginiaguesthouse.com/dining/poplar/" external class="text-base">The Poplar Restaurant →</TextLink>
          <TextLink href="https://www.google.com/maps/search/?api=1&query=The+Poplar+Restaurant+2017+Ivy+Rd+Charlottesville+VA" external class="text-base">Get Directions →</TextLink>
        </div>
      </div>

      <div class="mt-16">
        <h2 class="text-4xl font-medium tracking-[-0.36px] text-white">
          Pitch Night at the UVA School of Data Science
        </h2>
        <p class="mt-2 font-mono text-lg text-[#858fc6]">5:30pm – 8:30pm</p>
        <p class="mt-4 max-w-[567px] text-base leading-relaxed text-white/80">
          Pizza, pitches, and voting at 1919 Ivy Rd. Anyone can propose a session about
          something they would like to teach, share, demonstrate, discuss, or understand
          better. Topics may be technical, creative, professional, civic, practical, or
          completely unexpected.
        </p>
        <div class="mt-4 flex flex-wrap gap-x-10 gap-y-2">
          <TextLink href="https://datascience.virginia.edu/" external class="text-base">School of Data Science →</TextLink>
          <TextLink href="https://www.google.com/maps/place/School+of+Data+Science/data=!4m2!3m1!1s0x0:0x4105c4fd4e527c99?sa=X&ved=1t:2428&ictx=111" external class="text-base">Get Directions →</TextLink>
        </div>

        <div class="mt-12 divide-y divide-divider border-y border-divider">
          {pitchNightRows.map((row) => (
            <div class="flex flex-col gap-2 py-6 sm:flex-row sm:items-baseline sm:gap-0">
              <p class="w-44 shrink-0 whitespace-nowrap text-base font-medium tracking-[-0.18px] text-[#858fc6]">{row.time}</p>
              <p class="text-2xl font-medium tracking-[-0.24px] text-white">{row.title}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="px-5 sm:px-20 pt-24">
      <SectionLabel class="text-sm">Saturday, October 3rd</SectionLabel>
      <h2 class="mt-3 text-4xl font-medium tracking-[-0.36px] text-white">
        Sessions at the UVA School of Data Science
      </h2>
      <p class="mt-2 font-mono text-lg text-[#858fc6]">9am – 4pm</p>
      <p class="mt-4 max-w-[567px] text-base leading-relaxed text-white/80">
        A full day of community-selected conversations, workshops, demonstrations, and
        discoveries: breakfast, sessions, lunch, lightning talks, more sessions, and a
        retrospective.
      </p>
      <div class="mt-4 flex flex-wrap gap-x-10 gap-y-2">
        <TextLink href="https://datascience.virginia.edu/" external class="text-base">School of Data Science →</TextLink>
        <TextLink href="https://www.google.com/maps/place/School+of+Data+Science/data=!4m2!3m1!1s0x0:0x4105c4fd4e527c99?sa=X&ved=1t:2428&ictx=111" external class="text-base">Get Directions →</TextLink>
      </div>

      <div class="mt-12 divide-y divide-divider border-y border-divider">
        {sessions.length > 0
          ? scheduleRows.map((row) => (
              <div class="flex flex-col gap-3 py-5 sm:flex-row sm:gap-0">
                <p class="w-44 shrink-0 whitespace-nowrap pt-4 text-base font-medium tracking-[-0.18px] text-[#858fc6]">{row.time}</p>
                {/* Parallel tracks share one line from sm up — five tracks max;
                    anything beyond wraps. Single sessions span the full width. */}
                <div
                  class={`grid flex-1 grid-cols-1 gap-5 ${row.sessions.length > 1 ? 'sm:grid-cols-[repeat(var(--tracks),minmax(0,1fr))]' : ''}`}
                  style={row.sessions.length > 1 ? `--tracks: ${Math.min(row.sessions.length, 5)}` : undefined}
                >
                  {row.sessions.length > 0 ? (
                    row.sessions.map((session) => (
                      <div class="flex flex-col gap-1 border border-white/[0.08] bg-white/[0.03] px-4 py-3">
                        <p class="text-base font-medium text-white">{session.topic}</p>
                        {session.speaker && <p class="text-sm text-white/60">{session.speaker}</p>}
                        <p class="font-mono text-xs text-[#858fc6]">
                          {[session.location, session.type].filter(Boolean).join(' · ')}
                        </p>
                      </div>
                    ))
                  ) : (
                    <SponsorPlaceholder class="h-[65px] flex-1" />
                  )}
                </div>
              </div>
            ))
          : placeholderRows.map((row) => (
              <div class="flex flex-col gap-3 py-5 sm:flex-row sm:items-center sm:gap-0">
                <p class="w-44 shrink-0 whitespace-nowrap text-base font-medium tracking-[-0.18px] text-[#858fc6]">{row.time}</p>
                {row.slots === 3 ? (
                  <div class="grid flex-1 grid-cols-1 gap-5 sm:grid-cols-3">
                    <SponsorPlaceholder class="h-[65px]" />
                    <SponsorPlaceholder class="h-[65px]" />
                    <SponsorPlaceholder class="h-[65px]" />
                  </div>
                ) : (
                  <SponsorPlaceholder class="h-[65px] flex-1" />
                )}
              </div>
            ))}
      </div>
    </section>

    <CtaSection />
  </main>
  <Footer />
</Layout>
