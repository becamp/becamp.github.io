---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import CountdownBar from '../components/CountdownBar.astro';

interface Props {
  title: string;
  description?: string;
  /* The register page opts out — the bar's CTA points there, so it's noise once
     the visitor has arrived. */
  countdown?: boolean;
}

const {
  title,
  description = 'beCamp is a free, community-run un-conference for the Charlottesville tech community.',
  countdown = true,
} = Astro.props;
---

<!-- ClientRouter swaps pages in place so navigation doesn't flash; animate="none"
     keeps the swap instant rather than crossfading. Component scripts re-init via
     astro:page-load since module scripts only execute once per session. -->
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="bg-bg text-white">
    {countdown && <CountdownBar />}
    <slot />
  </body>
</html>
