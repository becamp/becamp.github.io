---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import CountdownBar from '../components/CountdownBar.astro';
import FlameBackdrop from '../components/FlameBackdrop.astro';

interface Props {
  title: string;
  description?: string;
  /* The register page opts out — the bar's CTA points there, so it's noise once
     the visitor has arrived. */
  countdown?: boolean;
}

const {
  title,
  description = 'beCamp is a free, community-run un-conference for the Charlottesville tech community.',
  countdown = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
---

<!-- ClientRouter swaps pages in place so navigation doesn't flash; animate="none"
     keeps the swap instant rather than crossfading. Component scripts re-init via
     astro:page-load since module scripts only execute once per session. -->
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="beCamp" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <ClientRouter />
  </head>
  <body class="bg-bg text-white">
    <script>
      /* iOS WebKit's back-trapping heuristic skips history entries it considers
         added without user interaction — which includes entries the ClientRouter
         pushes after its async page fetch. Result: back button / swipe-back
         jumps clean out of the site. On iOS, mark internal links
         data-astro-reload so navigation stays native and history correct;
         everyone else keeps client-side routing. */
      const isIOS =
        /iPhone|iPad|iPod/.test(navigator.userAgent) ||
        (navigator.userAgent.includes('Mac') && navigator.maxTouchPoints > 1); /* iPadOS masquerades as macOS */

      if (isIOS) {
        const optOut = () => {
          document.querySelectorAll('a[href^="/"]:not([data-astro-reload])').forEach((a) => {
            a.setAttribute('data-astro-reload', '');
          });
        };
        optOut();
        document.addEventListener('astro:page-load', optOut);
      }
    </script>
    {countdown && <CountdownBar />}
    <FlameBackdrop />
    <!-- relative lifts all page content above the absolutely-positioned shader,
         so the glow only shows through transparent backgrounds. -->
    <div class="relative">
      <slot />
    </div>
  </body>
</html>
